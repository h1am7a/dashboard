# Путь к SQLite базе данных (по умолчанию db/life.db в корне проекта)
PRIEST_DB=db/life.db

# Токен Telegram-бота для проверки подписи WebApp initData
BOT_TOKEN=

# Разрешённый Telegram User ID (для одного пользователя, узнайте свой ID через @userinfobot)
ALLOWED_USER_ID=

# Локальный режим разработки (true отключает проверку подписи Telegram для тестирования в браузере)
DEV_MODE=true

# Сервер
HOST=127.0.0.1
PORT=8000
