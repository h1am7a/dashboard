# Path to SQLite database (defaults to db/life.db in project root or /root/priest/db/life.db on server)
DB_PATH=db/life.db

# Telegram Bot Token for validating WebApp initData HMAC-SHA256 signature
BOT_TOKEN=

# Allowed Telegram User ID (single-user authorization, find your ID via @userinfobot)
ALLOWED_USER_ID=

# Local development mode (true disables Telegram signature check for web browser testing)
DEV_MODE=true

# Server configuration
HOST=127.0.0.1
PORT=8099
